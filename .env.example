# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas / local
# Example Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/job-integration-system
MONGODB_URI=mongodb://127.0.0.1:27017/job-integration-system

# Set to true to use mongodb-memory-server (no local MongoDB / Atlas required for tests)
USE_MEMORY_DB=false

# JWT — use a long random secret in production (32+ chars required when NODE_ENV=production)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=60

# Demo mode — all job board adapters run as mocks unless real credentials are set
DEMO_MODE=true

# When true (or DEMO_MODE=true), public registration may create recruiter accounts.
# Set both DEMO_MODE=false and ALLOW_PUBLIC_RECRUITER_SIGNUP=false in production.
ALLOW_PUBLIC_RECRUITER_SIGNUP=true

# Shared secret for inbound board webhooks (header: X-Webhook-Secret).
# Required in production when DEMO_MODE=false. Leave empty for local demo.
WEBHOOK_SECRET=
